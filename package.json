{
  "name": "aethermaster-ai-root",
  "version": "1.0.0",
  "private": true,
  "description": "AetherMaster AI",
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"magenta,cyan\" \"npm --prefix backend run dev\" \"npm --prefix frontend run dev\"",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "build": "cd frontend && npm install --include=dev && npm run build",
    "vercel-build": "cd frontend && npm install --include=dev && npm run build",
    "install:all": "npm install && npm --prefix backend install && npm --prefix frontend install",
    "playtest": "node scripts/autonomous_playtester.js",
    "playtest:30m": "node scripts/autonomous_playtester.js --interval=30",
    "playtest:log": "powershell -NoProfile -Command \"Get-Content -Tail 50 -Wait logs/playtester.log\"",
    "agent:cloud": "node scripts/run_antigravity_agent.js",
    "agent:30m": "node scripts/run_antigravity_agent.js --interval=30",
    "agent:log": "powershell -NoProfile -Command \"Get-Content -Tail 50 -Wait logs/antigravity_agent.log\""
  },
  "dependencies": {
    "@google/genai": "^2.21.0",
    "bcryptjs": "^3.0.2",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "msedge-tts": "^2.0.8",
    "mysql2": "^3.12.0",
    "pg": "^8.23.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
