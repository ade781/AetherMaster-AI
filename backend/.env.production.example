PORT=5000
NODE_ENV=production

# Database Configuration (Supabase PostgreSQL Cloud)
DB_DIALECT=postgres
DB_HOST=aws-0-ap-southeast-2.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.your_project_id
DB_PASS=your_supabase_password
DB_SSL=true

# Connection String Alternative
DATABASE_URL=postgresql://postgres.your_project_id:your_supabase_password@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres

# Google Gemini AI Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
